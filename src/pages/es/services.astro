---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Banner from '../../components/Banner.astro';
import CTA from '../../components/CTA.astro';
import { Image } from 'astro:assets';
import { getBrand } from '../../config/brand';
import { apartmentComplexImage, diningAreaImage, renovationImage, vanityImage } from '../../config/images';
import { getSiteData } from '../../data/localizedSiteData';
import { getTranslations } from '../../i18n/translations';

const brand = getBrand('es');
const siteData = getSiteData('es');
const text = getTranslations('es');
const serviceImages = [
  { src: apartmentComplexImage, alt: 'Exterior de un complejo de apartamentos' },
  { src: renovationImage, alt: 'Interior de apartamento en renovación' },
  { src: vanityImage, alt: 'Tocador y accesorios de baño' },
  { src: diningAreaImage, alt: 'Área de comedor y sala de un apartamento terminado' },
];
---

<BaseLayout title={text.services.pageTitle} description={`${text.services.pageDescription} ${brand.name}.`}>
  <Header slot="header" />
  <Banner title={text.services.bannerTitle} />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">{text.services.pageHeading}</h2>
        <p class="mt-3 text-text-muted leading-relaxed">{text.services.pageDescription}</p>
      </div>
      <div class="grid grid-cols-1 gap-12">
        {siteData.services.map((service, index) => (
          <article class:list={[
            "grid items-center gap-6 md:gap-10",
            index % 2 === 0
              ? "md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]"
              : "md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]",
          ]}>
            <div class:list={[
              "flex flex-col justify-center",
              index % 2 === 0 ? "md:order-1" : "md:order-2",
            ]}>
              <h3 class="font-heading text-h3 font-semibold text-text">{service.title}</h3>
              <p class="mt-2 text-text-muted leading-relaxed">{service.description}</p>
            </div>
            {serviceImages[index] && (
              <Image
                src={serviceImages[index].src}
                alt={serviceImages[index].alt}
                width={640}
                height={427}
                loading="lazy"
                decoding="async"
                class:list={[
                  "mx-auto aspect-4/3 w-full max-w-sm rounded-lg object-cover md:max-w-none",
                  index % 2 === 0 ? "md:order-2" : "md:order-1",
                ]}
              />
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA />
  <Footer slot="footer" />
</BaseLayout>
