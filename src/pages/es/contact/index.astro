---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import { getBrand } from '../../../config/brand';
import { getSiteData } from '../../../data/localizedSiteData';
import { getTranslations } from '../../../i18n/translations';

const brand = getBrand('es');
const siteData = getSiteData('es');
const text = getTranslations('es');
---

<BaseLayout title={text.contact.pageTitle} description={`${text.contact.description} ${brand.name}.`}>
  <Header slot="header" />
  <Banner title={text.contact.bannerTitle} />

  <section class="py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="space-y-5 text-center">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">{siteData.name}</h2>
        <p class="text-text-muted">{siteData.contactName}</p>
        <p class="text-text-muted leading-relaxed">{text.contact.intro}</p>
        <div class="space-y-3 text-text-muted">
          <p>
            <span class="font-semibold text-text">{text.contact.callUs}:</span>
            <a href={`tel:${siteData.phoneForTel}`} class="font-medium text-primary-light transition-colors hover:text-primary">{siteData.phoneFormatted}</a>
          </p>
          <p>
            <span class="font-semibold text-text">{text.contact.emailUs}:</span>
            <a href={`mailto:${siteData.email}`} class="font-medium text-primary-light transition-colors hover:text-primary">{siteData.email}</a>
          </p>
          <p>
            <span class="font-semibold text-text">{text.contact.serviceArea}:</span>
            {siteData.serviceArea}
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
