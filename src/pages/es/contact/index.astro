---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import { getBrand } from '../../../config/brand';
import { getSiteData } from '../../../data/localizedSiteData';
import { getTranslations } from '../../../i18n/translations';

const brand = getBrand('es');
const siteData = getSiteData('es');
const text = getTranslations('es');
---

<BaseLayout title={text.contact.pageTitle} description={`${text.contact.description} ${brand.name}.`}>
  <Header slot="header" />
  <Banner title={text.contact.bannerTitle} />

  <section class="py-section">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <p class="mx-auto mb-10 max-w-2xl text-center text-text-muted leading-relaxed">{text.contact.intro}</p>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-border bg-background p-6 shadow-sm">
        <h2 class="font-heading text-lg font-semibold text-text">{siteData.name}</h2>
        <p class="mt-1 text-text-muted">{siteData.contactName}</p>
      </div>
      <div class="rounded-lg border border-border bg-background p-6 shadow-sm">
        <h2 class="font-heading text-lg font-semibold text-text">{text.contact.callUs}</h2>
        <a href={`tel:${siteData.phoneForTel}`} class="mt-1 block font-medium text-primary-light transition-colors hover:text-primary">{siteData.phoneFormatted}</a>
      </div>
      <div class="rounded-lg border border-border bg-background p-6 shadow-sm">
        <h2 class="font-heading text-lg font-semibold text-text">{text.contact.emailUs}</h2>
        <a href={`mailto:${siteData.email}`} class="mt-1 block font-medium text-primary-light transition-colors hover:text-primary">{siteData.email}</a>
      </div>
      <div class="rounded-lg border border-border bg-background p-6 shadow-sm">
        <h2 class="font-heading text-lg font-semibold text-text">{text.contact.serviceArea}</h2>
        <p class="mt-1 text-text-muted">{siteData.serviceArea}</p>
      </div>
    </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
