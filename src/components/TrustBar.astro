---
import { getSiteData } from '../data/localizedSiteData';
import { getTranslations } from '../i18n/translations';
import { getLocale } from '../i18n/routing';

const locale = getLocale(Astro.currentLocale);
const siteData = getSiteData(locale);
const text = getTranslations(locale);

interface Props {
  items?: { label: string; value?: string }[];
}

const { items = siteData.trustItems } = Astro.props;
---

<section class="border-y border-border bg-surface" aria-label={text.trustSignals}>
  <div class="mx-auto max-w-site overflow-x-auto px-4 py-5 sm:px-6 sm:py-6">
    <ul class="grid grid-cols-2 md:grid-cols-4 mx-auto items-center gap-6" role="list">
      {items.map(({ label, value }: { label: string; value?: string }) => (
        <li class="flex shrink-0 items-center justify-center gap-2.5 text-sm sm:text-base">
          <span class="font-heading font-semibold text-text">
            {value && <span class="text-primary mr-1">{value}</span>}
            {label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
