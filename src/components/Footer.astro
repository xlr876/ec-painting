---
import { getBrand } from '../config/brand';
import { getSiteData } from '../data/localizedSiteData';
import { getTranslations } from '../i18n/translations';
import { getLocale, localizePath, withBase } from '../i18n/routing';

const locale = getLocale(Astro.currentLocale);
const brand = getBrand(locale);
const siteData = getSiteData(locale);
const text = getTranslations(locale);
const year = new Date().getFullYear();
const { footerNav } = siteData;
---

<footer class="bg-dark text-surface/80" transition:persist>
  <div class="mx-auto max-w-site px-4 py-12 sm:px-6 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">

      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex flex-col gap-2">
        <a href={localizePath('/', locale)} class="font-heading text-lg font-bold uppercase tracking-wide text-white">
          {brand.name}
        </a>
        {siteData.license && <span class="text-xs font-medium">{siteData.license}</span>}
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed">
          {siteData.tagline}
        </p>

        <!-- Social links (plain text) -->
        <div class="mt-5 flex flex-wrap items-center gap-4">
          {siteData.socials.facebook && (
            <a href={siteData.socials.facebook} target="_blank" rel="noopener noreferrer" class="text-sm text-surface/60 transition-colors hover:text-white">
              Facebook
            </a>
          )}
          {siteData.socials.instagram && (
            <a href={siteData.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-sm text-surface/60 transition-colors hover:text-white">
              Instagram
            </a>
          )}
          {siteData.socials.google && (
            <a href={siteData.socials.google} target="_blank" rel="noopener noreferrer" class="text-sm text-surface/60 transition-colors hover:text-white">
              Google
            </a>
          )}
        </div>
      </div>

      <!-- Nav columns -->
      {footerNav.map((col) => (
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-white">{col.title}</h3>
          <ul class="mt-3 space-y-2">
            {col.links.map(({ label, href }) => (
              <li>
                <a href={withBase(href)} class="text-sm transition-colors hover:text-white">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Contact info -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">{text.footer.contact}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={`tel:${siteData.phoneForTel}`} class="transition-colors hover:text-white">
              {siteData.phoneFormatted}
            </a>
          </li>
          <li>
            <a href={`mailto:${siteData.email}`} class="transition-colors hover:text-white">
              {siteData.email}
            </a>
          </li>
          <li>{siteData.serviceArea}</li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 border-t border-surface/10 pt-6 text-center text-sm">
      &copy; {year}{" "}{brand.name}. {text.footer.rights}
    </div>
  </div>
</footer>
